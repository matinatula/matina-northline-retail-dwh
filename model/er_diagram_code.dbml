Table FCT_SALES [headercolor: #C43D32] {
  SALES_KY int [pk, increment]
  TRANSACTION_ID varchar [not null]
  LINE_NUMBER int [not null]
  ITEM_KY int [not null]
  LOCN_KY int [not null]
  DAY_KY int [not null]
  CUSTOMER_KY int
  SLS_QTY decimal [not null]
  SLS_AMT decimal [not null]
  DSC_AMT decimal
  REC_INS_TS timestamp [not null]
  REC_UPDT_TS timestamp [not null]
  SRC_SYS_CD varchar [not null]
  BATCH_ID varchar [not null]

  indexes {
    (TRANSACTION_ID, LINE_NUMBER, ITEM_KY, LOCN_KY, DAY_KY) [unique]
    (ITEM_KY)
    (LOCN_KY)
    (DAY_KY)
    (CUSTOMER_KY)
  }

}

